import puppeteer from 'puppeteer';
import type { CV } from '@/types';

export async function generateCVPDF(
  cv: CV,
  template: string = 'modern'
): Promise<Buffer> {
  const html = renderCVTemplate(cv, template);

  const browser = await puppeteer.launch({
    headless: true,
    args: ['--no-sandbox', '--disable-setuid-sandbox'],
  });

  try {
    const page = await browser.newPage();
    await page.setContent(html, { waitUntil: 'networkidle0' });

    const pdf = await page.pdf({
      format: 'A4',
      printBackground: true,
      margin: {
        top: '15mm',
        right: '15mm',
        bottom: '15mm',
        left: '15mm',
      },
    });

    return Buffer.from(pdf);
  } finally {
    await browser.close();
  }
}

function renderCVTemplate(cv: CV, template: string): string {
  // Separate languages and presentation skills from other skill categories
  const languages = cv.skills.find((s) =>
    s.category.toLowerCase().includes('language')
  );
  const presentationSkills = cv.skills.find((s) =>
    s.category.toLowerCase().includes('presentation')
  );
  const otherSkills = cv.skills.filter(
    (s) =>
      !s.category.toLowerCase().includes('language') &&
      !s.category.toLowerCase().includes('presentation')
  );

  return `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${cv.personalInfo.name} - CV</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Segoe UI', 'Arial', 'Helvetica', sans-serif;
      font-size: 11pt;
      line-height: 1.4;
      color: #2c3e50;
    }
    
    .container {
      max-width: 210mm;
      margin: 0 auto;
    }
    
    header {
      margin-bottom: 15px;
      border-bottom: 2px solid #2563eb;
      padding-bottom: 12px;
      background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
      padding: 15px;
      border-radius: 6px 6px 0 0;
    }
    
    h1 {
      font-size: 24pt;
      color: #1e40af;
      margin-bottom: 8px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    
    .contact-info {
      font-size: 9.5pt;
      color: #475569;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 8px;
    }
    
    .contact-info a {
      color: #2563eb;
      text-decoration: none;
      transition: color 0.2s;
    }
    
    .contact-info a:hover {
      color: #1e40af;
      text-decoration: underline;
    }
    
    .contact-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    
    h2 {
      font-size: 14pt;
      color: #1e40af;
      margin-top: 18px;
      margin-bottom: 10px;
      border-bottom: 2px solid #cbd5e1;
      padding-bottom: 5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .summary {
      margin-bottom: 12px;
      font-size: 10.5pt;
      line-height: 1.5;
      text-align: justify;
      color: #475569;
    }
    
    .experience-item, .education-item {
      margin-bottom: 12px;
      padding-left: 10px;
      border-left: 3px solid #e0e7ff;
      padding-left: 12px;
    }
    
    .job-title {
      font-weight: 600;
      font-size: 11.5pt;
      color: #1e293b;
      margin-bottom: 3px;
    }
    
    .company {
      color: #64748b;
      font-size: 10pt;
      margin-bottom: 1px;
    }
    
    .dates {
      color: #94a3b8;
      font-size: 9.5pt;
      font-style: italic;
      margin-bottom: 4px;
    }
    
    .education-item {
      background: #f8fafc;
      padding: 10px 12px;
      border-radius: 5px;
      border-left: 3px solid #3b82f6;
    }
    
    .education-item .job-title {
      color: #1e40af;
      font-size: 11pt;
    }
    
    .gpa {
      color: #059669;
      font-weight: 600;
      margin-top: 3px;
      font-size: 9.5pt;
    }
    
    ul {
      margin-left: 18px;
      margin-top: 5px;
    }
    
    li {
      margin-bottom: 3px;
      font-size: 10pt;
      color: #475569;
      line-height: 1.4;
    }
    
    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
      margin-bottom: 10px;
    }
    
    .skill-tag {
      background: #dbeafe;
      color: #1e40af;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 9.5pt;
      font-weight: 500;
      border: 1px solid #bfdbfe;
    }
    
    .skill-group {
      margin-bottom: 12px;
    }
    
    .skill-group strong {
      color: #1e293b;
      font-size: 10.5pt;
      display: block;
      margin-bottom: 6px;
    }
    
    .languages-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-top: 8px;
    }
    
    .language-item {
      background: #f0fdf4;
      padding: 6px 10px;
      border-radius: 5px;
      border-left: 3px solid #10b981;
      font-size: 10pt;
      color: #065f46;
    }
    
    .presentation-skills {
      margin-top: 8px;
    }
    
    .presentation-item {
      background: #fef3c7;
      color: #92400e;
      padding: 5px 12px;
      border-radius: 4px;
      font-size: 9.5pt;
      font-weight: 500;
      border: 1px solid #fde68a;
    }
    
    section {
      page-break-inside: avoid;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>${cv.personalInfo.name}</h1>
      <div class="contact-info">
        ${cv.personalInfo.email ? `<span class="contact-item">📧 ${cv.personalInfo.email}</span>` : ''}
        ${cv.personalInfo.phone ? `<span class="contact-item">📱 ${cv.personalInfo.phone}</span>` : ''}
        ${cv.personalInfo.location ? `<span class="contact-item">📍 ${cv.personalInfo.location}</span>` : ''}
        ${cv.personalInfo.linkedin ? `<span class="contact-item">💼 <a href="${cv.personalInfo.linkedin}" target="_blank">${cv.personalInfo.linkedin.replace('https://', '').replace('http://', '')}</a></span>` : ''}
        ${cv.personalInfo.github ? `<span class="contact-item">💻 <a href="${cv.personalInfo.github}" target="_blank">${cv.personalInfo.github.replace('https://', '').replace('http://', '')}</a></span>` : ''}
        ${cv.personalInfo.website ? `<span class="contact-item">🌐 <a href="${cv.personalInfo.website}" target="_blank">${cv.personalInfo.website.replace('https://', '').replace('http://', '')}</a></span>` : ''}
      </div>
    </header>
    
    ${
      cv.summary
        ? `
    <section>
      <h2>Professional Summary</h2>
      <p class="summary">${cv.summary}</p>
    </section>
    `
        : ''
    }
    
    ${
      otherSkills && otherSkills.length > 0
        ? `
    <section>
      <h2>Key Skills</h2>
      ${otherSkills
        .map(
          (skillGroup) => `
        <div class="skill-group">
          <strong>${skillGroup.category}</strong>
          <div class="skills">
            ${skillGroup.items.map((skill) => `<span class="skill-tag">${skill}</span>`).join('')}
          </div>
        </div>
      `
        )
        .join('')}
    </section>
    `
        : ''
    }
    
    <section>
      <h2>Professional Experience</h2>
      ${cv.experience
        .map(
          (exp) => `
        <div class="experience-item">
          <div class="job-title">${exp.title}</div>
          <div class="company">${exp.company}${exp.location ? ` | ${exp.location}` : ''}</div>
          <div class="dates">${exp.startDate} - ${exp.current ? 'Present' : exp.endDate || 'Present'}</div>
          ${exp.description ? `<p style="margin-top: 4px; font-size: 10pt; color: #475569; line-height: 1.4;">${exp.description}</p>` : ''}
          ${
            exp.achievements && exp.achievements.length > 0
              ? `
          <ul>
            ${exp.achievements.map((achievement) => `<li>${achievement}</li>`).join('')}
          </ul>
          `
              : ''
          }
        </div>
      `
        )
        .join('')}
    </section>
    
    ${
      cv.education && cv.education.length > 0
        ? `
    <section>
      <h2>Education</h2>
      ${cv.education
        .map(
          (edu) => `
        <div class="education-item">
          <div class="job-title">${edu.degree}</div>
          <div class="company">${edu.institution}${edu.location ? ` | ${edu.location}` : ''}</div>
          <div class="dates">${edu.graduationDate}</div>
          ${edu.gpa ? `<div class="gpa">GPA: ${edu.gpa}</div>` : ''}
          ${edu.description ? `<p style="margin-top: 4px; font-size: 10pt; color: #475569; line-height: 1.4;">${edu.description}</p>` : ''}
        </div>
      `
        )
        .join('')}
    </section>
    `
        : ''
    }
    
    ${
      presentationSkills && presentationSkills.items.length > 0
        ? `
    <section>
      <h2>Presentation Skills</h2>
      <div class="presentation-skills">
        <div class="skills">
          ${presentationSkills.items.map((skill) => `<span class="presentation-item">${skill}</span>`).join('')}
        </div>
      </div>
    </section>
    `
        : ''
    }
    
    ${
      languages && languages.items.length > 0
        ? `
    <section>
      <h2>Languages</h2>
      <div class="languages-grid">
        ${languages.items.map((lang) => `<div class="language-item">${lang}</div>`).join('')}
      </div>
    </section>
    `
        : ''
    }
    
    ${
      cv.projects && cv.projects.length > 0
        ? `
    <section>
      <h2>Projects</h2>
      ${cv.projects
        .map(
          (project) => `
        <div class="experience-item">
          <div class="job-title">${project.name}</div>
          <p style="margin-top: 4px; margin-bottom: 6px; font-size: 10pt; color: #475569; line-height: 1.4;">${project.description}</p>
          ${project.url ? `<div style="margin-bottom: 6px;"><a href="${project.url}" style="color: #2563eb; font-size: 9.5pt;">🔗 ${project.url}</a></div>` : ''}
          <div class="skills">
            ${project.technologies.map((tech) => `<span class="skill-tag">${tech}</span>`).join('')}
          </div>
        </div>
      `
        )
        .join('')}
    </section>
    `
        : ''
    }
    
    ${
      cv.certifications && cv.certifications.length > 0
        ? `
    <section>
      <h2>Certifications</h2>
      ${cv.certifications
        .map(
          (cert) => `
        <div class="experience-item">
          <div class="job-title">${cert.name}</div>
          <div class="company">${cert.issuer} | <span class="dates">${cert.date}</span></div>
          ${cert.url ? `<div style="margin-top: 3px;"><a href="${cert.url}" style="color: #2563eb; font-size: 9.5pt;">🔗 View Certificate</a></div>` : ''}
        </div>
      `
        )
        .join('')}
    </section>
    `
        : ''
    }
  </div>
</body>
</html>
  `;
}

export async function generateCoverLetterPDF(
  content: string,
  htmlContent?: string
): Promise<Buffer> {
  const html = htmlContent || renderCoverLetterTemplate(content);

  const browser = await puppeteer.launch({
    headless: true,
    args: ['--no-sandbox', '--disable-setuid-sandbox'],
  });

  try {
    const page = await browser.newPage();
    await page.setContent(html, { waitUntil: 'networkidle0' });

    const pdf = await page.pdf({
      format: 'A4',
      printBackground: true,
      margin: {
        top: '25mm',
        right: '20mm',
        bottom: '25mm',
        left: '20mm',
      },
    });

    return Buffer.from(pdf);
  } finally {
    await browser.close();
  }
}

function renderCoverLetterTemplate(content: string): string {
  return `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #333;
      max-width: 170mm;
      margin: 0 auto;
    }
    
    p {
      margin-bottom: 15px;
      text-align: justify;
    }
  </style>
</head>
<body>
  ${content
    .split('\n\n')
    .map((para) => `<p>${para}</p>`)
    .join('')}
</body>
</html>
  `;
}
